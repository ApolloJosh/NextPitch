  "built": "2026-09-01",
  "source": "MLB StatsAPI season pitching lines, 2015-2026 (the Statcast era)",
  "method": {
    "eraPlus": "100 * leagueERA(season) / pitcherERA(season), capped at 250. League ERA is computed from the summed earned runs and outs of every pitcher that season. No park factor, so this is an approximation of true ERA+.",
    "excluded": "2020 \u2014 a 60-game season is not comparable as a peak, in either rate or counting stats.",
    "qualify": "Starters: >=120 IP and >=60% of appearances started. Closers: >=45 IP and >=15 saves. Two qualifying seasons minimum.",
    "score": "Starters (IP/200)*(ERA+/100)*14 + W*0.5.  Closers (IP/70)*(ERA+/100)*9 + SV*0.32.  Ranked on best single season + 0.06 * career total, so a three-year ace is judged against a twelve-year veteran on equal footing.",
    "roles": "Starters and closers are ranked on separate scales \u2014 one IP/W/SV formula cannot compare them. The pool is 22 starters and 8 closers by design.",
    "balance": "16 starters by pure merit, then 6 more whose peak season is 2021 or later, so the pool is not 80% 2015-19."
  },
